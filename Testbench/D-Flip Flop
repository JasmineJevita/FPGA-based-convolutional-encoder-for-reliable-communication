module dff_tb();
reg clk;
reg reset;
reg d;
wire q;

dff x0 (
    .clk(clk),
    .reset(reset),
    .d(d),
    .q(q));

always #10 clk = ~clk;

initial begin
   
    clk = 0;
    reset = 1;
    d = 0;

    #10 reset = 0;

    #10 d = 1;
    #10 d = 0;
    #10 d = 1;
    #10 d = 0;
    #10 d = 1;
    #10 d = 1;
    #10 d = 0;
    #10 d = 1;
  
    #20 $finish;
end
endmodule

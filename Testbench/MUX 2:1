module mux2to1_tb();

reg a, b, sel;
wire y;

integer i;

reg [7:0] data = 8'b11010011;

mux2to1 uut (
    .a(a),
    .b(b),
    .sel(sel),
    .y(y)
);

initial begin

    $monitor("time=%0t a=%b b=%b sel=%b y=%b",
              $time,a,b,sel,y);

    for(i=7; i>=0; i=i-1)
    begin
        a = data[i];     
        b = ~data[i];    
        sel = i % 2;     
        #10;
    end

    $finish;

end

endmodule
